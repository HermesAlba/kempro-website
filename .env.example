# Sanity CMS
# Create a project at https://www.sanity.io/manage (or run `npx sanity@latest init`
# from the project root) and fill these in your local .env.local — see README.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only write token (Editor/Write permissions), created at
# sanity.io/manage → API → Tokens. Never expose this to the client.
SANITY_API_WRITE_TOKEN=

# Resend (email notifications for the contact form)
# Create an API key at https://resend.com/api-keys — see README.md.
RESEND_API_KEY=

# Google reCAPTCHA v3 (bot protection for the contact form)
# Register a v3 site at https://www.google.com/recaptcha/admin — see README.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4 (only loads if the visitor accepts the "Analíticas"
# category in the cookie consent banner) — see README.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
