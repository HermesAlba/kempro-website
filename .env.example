# Sanity CMS
# Create a project at https://www.sanity.io/manage (or run `npx sanity@latest init`
# from the project root) and fill these in your local .env.local — see README.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only write token (Editor/Write permissions), created at
# sanity.io/manage → API → Tokens. Never expose this to the client.
SANITY_API_WRITE_TOKEN=

# Resend (email notifications for the contact form)
# Create an API key at https://resend.com/api-keys — see README.md.
RESEND_API_KEY=

# Google reCAPTCHA v3 (bot protection for the contact form)
# Register a v3 site at https://www.google.com/recaptcha/admin — see README.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4 (only loads if the visitor accepts the "Analíticas"
# category in the cookie consent banner) — see README.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (error monitoring — client, server and edge runtimes; see
# instrumentation.ts / instrumentation-client.ts / sentry.*.config.ts).
# DSN from https://kempro-sas.sentry.io/settings/projects/javascript-nextjs/keys/
# — public by design (Sentry DSNs only allow *sending* events, not reading
# data), safe to expose to the client. Left unset, the SDK is a no-op.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only (Vercel env var, not needed in .env.local):
# lets the build upload source maps to Sentry so stack traces show real
# code instead of the minified bundle. Generate at
# sentry.io/settings/account/api/auth-tokens/. Without it the build still
# succeeds, source maps just aren't uploaded.
SENTRY_AUTH_TOKEN=
